# Repository owner: masterzee001

# Realtime Gateway
# Developer-surface telemetry at GET /internal/diagnostics (role-gated, off by
# default; requires the internal token when INTERNAL_WEBRTC_TOKEN is set).
# Development-only per-call transcript log (JSONL per call: captions, generated
# voice, ingest faults). Off unless set; call content is written to disk, so keep
# it unset outside local development.
CALL_TRANSCRIPT_LOG_DIR=
WEBRTC_DIAGNOSTICS_ENABLED=false
GATEWAY_PORT=3001
GATEWAY_HOST=127.0.0.1
GATEWAY_URL=http://localhost:3001
# THE browser-facing media-ingest base URL. Canonical name, read by BOTH the
# gateway and media-ingest; media-ingest mints every generated-audio URL from it.
#
# Leave blank ONLY when every client runs on this same machine. A phone, tablet
# or second laptop resolves a loopback address to ITSELF, finds nothing there,
# and reports the failure as a media/format error — which looks nothing like a
# configuration problem and cost two rounds of investigation on 17 Aug 2026.
# For LAN testing set the machine's address, e.g. http://192.168.0.179:3002
#
# Falls back to MEDIA_INGEST_URL, then to http://localhost:3002 with a startup
# warning. INGEST_PUBLIC_URL is a deprecated alias and still accepted.
# Set MEDIA_INGEST_REQUIRE_PUBLIC_URL=true to make a loopback value a hard
# startup failure instead of a warning.
# Where uploaded programme media is written. Defaults to ../../uploads/media-ingest
# relative to the process working directory, which is fine for a checkout and
# wrong for a deployment: it places writable state inside the code tree.
MEDIA_INGEST_UPLOAD_DIR=
MEDIA_INGEST_PUBLIC_URL=
MEDIA_INGEST_REQUIRE_PUBLIC_URL=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
EVENT_ID=demo-event
MEDIA_INGEST_URL=http://localhost:3002
# Shared credential for the INTERNAL media API, which can create a processing
# session, push audio into it, stop it and delete it. The gateway sends it and
# media-ingest verifies it, so both must be given the SAME value.
#
# This used to ship blank, and a blank value DISABLED authentication rather than
# refusing requests — so a default deployment accepted audio from anyone who
# could reach the port. Missing security configuration now means the service
# REFUSES TO START, not that security is off.
#
# Set one of these two. Generate a token with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ...or, for local development only, accept the risk deliberately by setting
# VIDEOFY_ALLOW_INSECURE_INTERNAL_INGRESS=true. Never do that on a host whose
# network you do not control. Note this authenticates a CALLER and says nothing
# about which session it may write into; per-session authorization arrives with
# the adapter ingress binding.
#
# Independently of this token: media-ingest should bind to localhost or a
# private network, and its port must not be reachable from the Internet.
# Application authentication is the second line, not the first.
INTERNAL_WEBRTC_TOKEN=
VIDEOFY_ALLOW_INSECURE_INTERNAL_INGRESS=
# Live audio chunking: fixed chunk length when VAD is off; VAD ends segments at natural pauses.
WEBRTC_TRANSCRIPTION_CHUNK_MS=5000
# Streaming captions: emit an interim caption every N ms while someone is still
# speaking (native calls only). 0 disables. Interim results never produce audio.
WEBRTC_PARTIAL_CAPTION_INTERVAL_MS=1500
WEBRTC_VAD_ENABLED=true
WEBRTC_VAD_MODE=fallback
WEBRTC_VAD_SPEECH_THRESHOLD=0.012
WEBRTC_VAD_END_SILENCE_MS=700
WEBRTC_VAD_MIN_SPEECH_MS=500
WEBRTC_VAD_MAX_SEGMENT_MS=8000
WEBRTC_AUDIO_CHUNK_STAGING_DIR=../../uploads/webrtc-staging

# Media Ingest
# P6-G0 policy profile. The current provider wiring remains development/demo.
# Any commercial or Videofy-native value fails startup until a complete certified
# provider selection is explicitly integrated in a later milestone.
AI_RUNTIME_PROFILE=development-demo
INGEST_PORT=3002
# Bind address for media-ingest. Defaults to localhost: this process holds
# every commercial credential and must never be internet-reachable. Set it
# only when another HOST legitimately needs the internal API.
INGEST_HOST=127.0.0.1
INGEST_UPLOAD_MAX_BYTES=2147483648
AUDIO_CHUNK_DIR=../../uploads/audio-chunks
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_TIMEOUT_MS=30000
TRANSCRIPTION_SOURCE_LANGUAGE=en
WEBRTC_TRANSCRIPTION_REQUEST_TIMEOUT_MS=180000
FASTER_WHISPER_PYTHON=python
FASTER_WHISPER_FFMPEG=ffmpeg
# `small` is multilingual (unlike `small.en`) and is an opt-in local model;
# pre-stage it before use because runtime model downloads stay disabled.
FASTER_WHISPER_MODEL_SIZE=small
# GPU: set DEVICE=cuda and COMPUTE_TYPE=float16 (measured ~7x faster than cpu/int8
# on an RTX 5060; int8_float16 is NOT supported on Blackwell - cuBLAS rejects it).
# ALLOW_GPU_FALLBACK=true keeps calls working if the GPU is unavailable.
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_MODEL_CACHE_DIR=
FASTER_WHISPER_ALLOW_GPU_FALLBACK=false
TRANSLATION_PROVIDER=mock
TRANSLATION_TIMEOUT_MS=30000
TRANSLATION_TARGET_LANGUAGE=fr
TRANSLATION_SUPPORTED_TARGET_LANGUAGES=fr,es,de,pt,it,ja,zh,ar,yo,en
ARGOS_TRANSLATE_PYTHON=python
ARGOS_TRANSLATE_PACKAGE_DIR=
OPUS_MT_PYTHON=python
OPUS_MT_MODEL_CACHE_DIR=
OPUS_MT_MAX_CONCURRENCY=1
OPUS_MT_ALLOW_MODEL_DOWNLOAD=false
OPUS_MT_LANGUAGE_MODELS=en:fr:Helsinki-NLP/opus-mt-en-fr,en:es:Helsinki-NLP/opus-mt-en-es,es:en:Helsinki-NLP/opus-mt-es-en,fr:en:Helsinki-NLP/opus-mt-fr-en
# Per-pair fallback: when the primary provider lacks a language pair (e.g. en->yo
# has no OPUS-MT model), route that pair to a multilingual model instead of
# failing. "nllb200" (facebook/nllb-200-distilled-600M, CC-BY-NC-4.0 â€” review
# before commercial use) gives far better low-resource quality than "m2m100".
TRANSLATION_FALLBACK_PROVIDER=none
NLLB200_MODEL_ID=facebook/nllb-200-distilled-600M
NLLB200_PYTHON=python
NLLB200_MODEL_CACHE_DIR=
NLLB200_MAX_CONCURRENCY=1
NLLB200_ALLOW_MODEL_DOWNLOAD=false
# Set TRANSLATION_PROVIDER=m2m100 for one local MIT-licensed model covering es,fr,pt,yo,zh.
M2M100_PYTHON=python
M2M100_MODEL_ID=facebook/m2m100_418M
M2M100_LOCAL_PATH=
M2M100_MODEL_CACHE_DIR=
M2M100_MAX_CONCURRENCY=1
M2M100_ALLOW_MODEL_DOWNLOAD=false
# "piper+mms" routes languages with a configured Piper voice to Piper and the
# rest to MMS-TTS (VITS via transformers).
TEXT_TO_SPEECH_PROVIDER=mock
# MMS-TTS voices: language|modelId[|localPath]. facebook/mms-tts-* models are
# CC-BY-NC-4.0 â€” review the licence before commercial use.
MMS_TTS_VOICES=yo|facebook/mms-tts-yor
MMS_TTS_PYTHON=python
MMS_TTS_MODEL_CACHE_DIR=
MMS_TTS_ALLOW_MODEL_DOWNLOAD=false
TEXT_TO_SPEECH_TIMEOUT_MS=30000
TEXT_TO_SPEECH_SUPPORTED_LANGUAGES=fr,es,de,pt,it,ja,zh,ar,yo,en
TEXT_TO_SPEECH_DEFAULT_VOICE_ID=mock-voice
PIPER_EXECUTABLE=piper
PIPER_FFMPEG=ffmpeg
# Multi-voice registry: comma-separated entries of language|voiceId|modelPath[|configPath].
# Pipe-separated fields because Windows paths contain colons. Wins over the legacy vars below.
# HFC voices are CC-BY-NC-SA and therefore development/demo only; these candidates
# do not claim quality, licence approval, or standard-voice readiness.
PIPER_VOICES=en|en_US-hfc_male-medium|../../models/piper/en_US-hfc_male-medium.onnx|../../models/piper/en_US-hfc_male-medium.onnx.json,en|en_US-hfc_female-medium|../../models/piper/en_US-hfc_female-medium.onnx|../../models/piper/en_US-hfc_female-medium.onnx.json,es|es_ES-sharvard-male|../../models/piper/es_ES-sharvard-medium.onnx|../../models/piper/es_ES-sharvard-medium.onnx.json,es|es_ES-sharvard-female|../../models/piper/es_ES-sharvard-medium.onnx|../../models/piper/es_ES-sharvard-medium.onnx.json,fr|fr_FR-siwis-medium|../../models/piper/fr_FR-siwis-medium.onnx|../../models/piper/fr_FR-siwis-medium.onnx.json,fr|fr_FR-upmc-pierre|../../models/piper/fr_FR-upmc-medium.onnx|../../models/piper/fr_FR-upmc-medium.onnx.json
# Optional per-voice prosody overrides, JSON keyed by voiceId:
# {"voiceId":{"lengthScale":1.05,"noiseScale":0.667,"noiseW":0.8,"sentenceSilence":0.25,"sampleRateHz":22050,"speakerId":0}}
# `speakerId` is for multi-speaker Piper models and accepts zero.
PIPER_VOICE_SETTINGS={"fr_FR-upmc-pierre":{"speakerId":1},"es_ES-sharvard-male":{"speakerId":0},"es_ES-sharvard-female":{"speakerId":1}}
# Legacy single-voice fallback (used only when PIPER_VOICES is unset).
PIPER_VOICE_ID=es_ES-sharvard-medium
PIPER_VOICE_LANGUAGE=es
PIPER_MODEL_PATH=../../models/piper/es_ES-sharvard-medium.onnx
PIPER_CONFIG_PATH=
VIDEO_SOURCE=mock
MOCK_VIDEO_DURATION_MS=300000
MOCK_VIDEO_TICK_MS=1000
TRANSLATED_LANGUAGES=fr,es

# Speech Worker
SPEECH_WORKER_PORT=8001
SPEECH_WORKER_MODE=mock
MOCK_PHRASE_INTERVAL_MS=4000
SEQUENCE_START=1
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=fr

# Frontend apps
VITE_GATEWAY_URL=http://localhost:3001
VITE_INGEST_URL=http://localhost:3002
VITE_SOCKET_TRANSPORT=polling
# Listener sync tuning: audio schedule delay behind the live clock, and how late a
# translated clip may run past its window before it is skipped.
VITE_VIEWER_SYNC_DELAY_MS=8000
VITE_VIEWER_LATE_DROP_TOLERANCE_MS=2500

# Logging
LOG_LEVEL=info

# --- Accounts (P6.4) ---
# Shared HMAC key for session tokens. The account service SIGNS with it and the
# gateway and media-ingest VERIFY with it, so all three must be given the same
# value or nobody can sign in. Services refuse to start without it rather than
# defaulting: a key committed to a repository is a key every deployment shares.
#
# Generate one and put it in your own .env, never here:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIDEOFY_AUTH_SECRET=
ACCOUNT_PORT=3006
# Bind address for the account service. Defaults to localhost; it is reached
# through the reverse proxy.
ACCOUNT_HOST=127.0.0.1

# --- C-AI1 commercial AI providers -----------------------------------------
# NAMES ONLY. Never commit a value here. Every one of these is backend-only and
# must not reach any browser bundle; media-ingest is the sole consumer.
#
# An ABSENT credential sets the provider's operationalState to `disabled`. It
# does NOT change its integration stage, and it never causes a silent fallback
# to an uncertified vendor - selection fails closed instead.
#
# Nothing below is PRIMARY or CERTIFIED. Certification is per
# provider + capability + language route + service category, and requires
# recorded benchmark evidence (C-AI1.2).

# Deepgram - first commercial STT candidate (streaming and batch)
DEEPGRAM_API_KEY=

# Google Cloud - first commercial translation candidate
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TRANSLATE_PROJECT_ID=

# ElevenLabs - first commercial TTS candidate
ELEVENLABS_API_KEY=

# Microsoft Azure - comparison candidate across STT/MT/TTS
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# 9jaLingo (NaijaLingo) - specialist candidate for Nigerian languages.
# No adapter exists yet; the API surface has not been documented here.
NAIJALINGO_API_KEY=
NAIJALINGO_BASE_URL=
