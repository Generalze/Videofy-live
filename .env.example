# Realtime Gateway
GATEWAY_PORT=3001
GATEWAY_HOST=localhost
GATEWAY_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
EVENT_ID=demo-event

# Media Ingest
INGEST_PORT=3002
VIDEO_SOURCE=mock
MOCK_VIDEO_DURATION_MS=300000
MOCK_VIDEO_TICK_MS=1000
TRANSLATED_LANGUAGES=fr,es

# Speech Worker
SPEECH_WORKER_PORT=8001
SPEECH_WORKER_MODE=mock
MOCK_PHRASE_INTERVAL_MS=4000
SEQUENCE_START=1
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=fr

# Frontend apps
VITE_GATEWAY_URL=http://localhost:3001

# Logging
LOG_LEVEL=info
