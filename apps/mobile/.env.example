# Copy to .env.
#
# EVERYTHING HERE IS PUBLIC. Anything prefixed EXPO_PUBLIC_ is compiled into the
# app bundle in plain text and readable by anyone who unpacks the APK. Expo says
# this explicitly, and it is why no session token, API key or secret of any kind
# may appear in this file -- not even a development one, because a development
# shortcut that works is a shortcut that ships.
#
# Credentials belong in device secure storage, obtained by signing in.

# Which public environment this build targets: staging or production.
EXPO_PUBLIC_APP_ENV=staging

# Where the realtime gateway lives.
EXPO_PUBLIC_GATEWAY_URL=https://staging.consummate7.com

# Where the account service lives. Caddy mounts it under /auth and strips the
# prefix, so the app appends /devices and /health to this.
EXPO_PUBLIC_ACCOUNT_URL=https://staging.consummate7.com/auth

# Where media-ingest lives.
EXPO_PUBLIC_INGEST_URL=https://staging.consummate7.com/media

# Where the embedded listener web app lives.
EXPO_PUBLIC_LISTEN_URL=https://staging.consummate7.com/listen

# Where public web links such as /add/<username> live.
EXPO_PUBLIC_WEB_URL=https://staging.consummate7.com

# Developer switch: 1 shows the call diagnostics line (voice legs, ICE, transport
# events) on the call screen. Off in every build a person installs.
EXPO_PUBLIC_CALL_DIAGNOSTICS=

# Optional public label shown only when call diagnostics are enabled.
EXPO_PUBLIC_BUILD_LABEL=
