# Copy to .env. Values here are NOT secret: anything prefixed EXPO_PUBLIC_ is
# compiled into the app bundle and readable by anyone who unpacks the APK.
# Never put a real credential behind that prefix.

# Where the account service lives. Caddy mounts it under /auth and strips the
# prefix, so this includes /auth and the app appends /devices to it.
EXPO_PUBLIC_ACCOUNT_URL=https://staging.consummate7.com/auth

# A session token, for testing device registration before sign-in exists in the
# app. Short-lived and personal -- keep it in .env, which is gitignored.
EXPO_PUBLIC_DEV_SESSION=
