{
  "name": "connect-reference-server",
  "version": "0.1.0",
  "private": true,
  "author": "masterzee001",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "description": "Connect Reference product server: durable rooms, host keys, and join tokens built entirely on the public Videofy Connect server SDK.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check:vocab": "node scripts/check-vocab.mjs",
    "test": "node scripts/check-vocab.mjs && vitest run"
  },
  "dependencies": {
    "@videofy/server-sdk": "*",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
