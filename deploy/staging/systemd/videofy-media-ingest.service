[Unit]
Description=Videofy Live media ingest (holds provider credentials)
After=network-online.target
Wants=network-online.target

# THE RESTART STORM THIS UNIT ONCE PRODUCED, AND WHY IT COULD.
#
# With Restart=on-failure and RestartSec=3, systemd's DEFAULT rate limit --
# 5 starts in 10 seconds -- can never be reached: only about three attempts fit
# in the window. So a service that fails instantly at startup restarts for
# ever, silently. This unit did exactly that 106,722 times while the platform
# reported healthy, because nothing above it distinguished "the process was
# started" from "the process is running".
#
# AND THE FIRST FIX HAD THE SAME BUG. 300 seconds and 10 starts looks generous
# until the geometric backoff below is included: 3s, 5.5s, 9.9s, 18.1s, 33s,
# then 60s repeating, which puts the tenth start at about 309 seconds. Ten
# starts do not fit in 300, so the limit was unreachable for a second time.
#
# 600 seconds fits that schedule with room to spare. These four numbers --
# interval, burst, RestartSec, RestartMaxDelaySec -- are one calculation, and
# the test beside them recomputes it rather than trusting the comment.
#
# They live in [Unit] because that is where systemd's parser defines them.
# There is a [Service] compatibility alias for the older StartLimitInterval
# spelling only, so the modern spelling in [Service] is silently ignored.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=videofy
Group=videofy
WorkingDirectory=/srv/videofy/app/services/media-ingest
# Names come from this file; VALUES never appear in the unit, in the repository,
# or in journald. 0600 and owned by root: the service user reads it, nobody else.
EnvironmentFile=/etc/videofy/media-ingest.env
# This service sets rootDir to the monorepo root, so tsc mirrors the repo
# layout under dist/. The entry is nested; it is not dist/index.js.
ExecStart=/usr/bin/node dist/services/media-ingest/src/index.js

# The services already close their listeners and drain on SIGTERM. systemd's
# default signal is SIGTERM, so graceful shutdown needs no special handling --
# only enough time to finish, and a KILL backstop if it does not.
KillSignal=SIGTERM
TimeoutStopSec=25

Restart=on-failure
# The backoff the start limit in [Unit] is calculated against. Changing any of
# these three without redoing that arithmetic can make the limit unreachable
# again -- which is the whole defect, not a detail of it.
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=60

# Least privilege. This process is reachable from the edge (or, for
# media-ingest, holds every commercial credential), so it gets no more of the
# filesystem than it needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# PROGRAMME_MEDIA_SPOOL LIVES UNDER /srv/videofy/state/programme-media, and that is
# why the state tree is here. The protected buffer is the only durable copy of
# a broadcast that has not aired yet; if it is moved outside these paths the
# service can still start, and the first protected run fails on air with a
# read-only filesystem.
ReadWritePaths=/srv/videofy/state /srv/videofy/uploads
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=videofy-media-ingest

[Install]
WantedBy=multi-user.target
