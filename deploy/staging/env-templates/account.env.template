# Videofy Live — account service. NAMES ONLY. Never commit a populated copy.
#
# Installed to /etc/videofy/account.env, mode 0600, owner root, group videofy.

ACCOUNT_PORT=3006
# Loopback: reached through Caddy at /auth/*.
ACCOUNT_HOST=127.0.0.1

# Signs sessions. MUST be byte-identical to the gateway's.
VIDEOFY_AUTH_SECRET=

# development | staging | production
#
# REQUIRED. Anything unrecognised -- including absent -- is treated as
# production, and the service then REFUSES TO START while any verification
# channel is configured with a synthetic provider. That is deliberate: a
# synthetic provider delivers nothing and would mark accounts verified without
# any verification having happened. A typo here must fail loudly at boot rather
# than quietly enable it.
C7_ENVIRONMENT=staging

# Shared secret the identity provider signs its callbacks with. Absent, the
# callback route refuses everything rather than accepting unsigned results.
C7_IDENTITY_CALLBACK_SECRET=

# --- where accounts live -----------------------------------------------------
#
# file | postgres
#
# `file` is a DEVELOPMENT PROTOTYPE: password hashes unencrypted on disk, every
# account rewritten on every write, and no way to survive the box. It is
# REFUSED outright when C7_ENVIRONMENT=production.
#
# Chosen explicitly rather than inferred from whether DATABASE_URL is set,
# because a missing variable would then silently downgrade a real deployment to
# a JSON file and look perfectly healthy doing it.
C7_ACCOUNT_STORE=file

# Required when C7_ACCOUNT_STORE=postgres. There is NO in-memory fallback: the
# service refuses to start rather than accepting registrations it will forget.
# Format: postgres://user:password@host:5432/database
DATABASE_URL=

# --- second factor ------------------------------------------------------------
#
# A KEYRING, not a key, because rotation has to be possible from day one: a
# design with one key cannot be rotated without re-encrypting every record while
# the service runs, and that migration gets written under pressure or never.
#
#   C7_MFA_KEYRING=k1:<64 hex chars>:current,k0:<64 hex chars>
#
# Exactly one entry is marked `current` and is what new secrets are sealed
# under; the others still OPEN records sealed under them earlier. A malformed
# entry refuses to start rather than silently shrinking the keyring, because a
# record sealed under a key that quietly went missing stops opening and the
# symptom is somebody locked out of their own second factor.
#
# Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
C7_MFA_KEYRING=

# Pepper for recovery-code hashes. At least 32 characters.
#
# Recovery codes carry about 33 bits of entropy. Hashed without a pepper held
# separately from the database, a stolen table is an offline brute force a GPU
# clears in minutes. Setting the keyring without this REFUSES TO START.
C7_MFA_RECOVERY_PEPPER=

# Both unset means MFA is simply not configured and its routes 404. Half
# configured is refused: an account enrolled against a half-working factor is
# one nobody discovers is broken until they need it.

# --- security observability --------------------------------------------------
#
# Salt for hashing addresses in security events, so "this address has requested
# forty resets" is countable WITHOUT the address being retained in a log that
# far more people can read than can read the database.
#
# UNSET means addresses are OMITTED from events -- never logged in the clear as
# a fallback. Must be at least 16 characters if set: an unsalted digest of an
# email address is reversible by anybody holding a list of email addresses,
# which is everybody. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
C7_SECURITY_TARGET_SALT=

# --- policy consent ----------------------------------------------------------
#
# Which policy versions this deployment requires, as policyType:version pairs.
#   C7_REQUIRED_POLICIES=terms-of-service:2026-01-15,privacy-policy:2026-01-15
#
# EMPTY MEANS NOTHING IS REQUIRED, and that is the correct default until
# approved policy CONTENT exists. Naming a version before the document is
# written collects agreement to nothing and produces records that look like
# evidence and are not.
#
# A malformed entry REFUSES TO START rather than silently requiring nothing.
C7_REQUIRED_POLICIES=

# --- verification delivery -------------------------------------------------
#
# Selection throws on anything ambiguous: an unrecognised name, a missing
# credential, or synthetic while the environment is production. A typo must not
# resolve to a default, because every one of those failures ends the same way --
# a system that believes it verified somebody.

# synthetic | resend
C7_EMAIL_PROVIDER=synthetic
RESEND_API_KEY=
# The verified sending identity, e.g. "Consummate 7 <verify@yourdomain>".
C7_EMAIL_FROM=
# Absolute scheme://host with no path. Verification links are built from THIS,
# never from a request header -- a link built from a Host header mails an
# attacker's domain to a real user's inbox with the token attached.
C7_PUBLIC_ORIGIN=https://staging.consummate7.com

# synthetic | termii
C7_PHONE_PROVIDER=synthetic
TERMII_API_KEY=
# The approved sender id or device name on the Termii account.
TERMII_SENDER_ID=
# Termii documents the path as {BASE_URL}/api/sms/send and the base is account
# and region specific, so it is REQUIRED rather than assumed.
TERMII_BASE_URL=
# generic | dnd  ('dnd' reaches numbers on the do-not-disturb list)
TERMII_CHANNEL=generic

# --- federated sign-in (Google, KingsChat) ---
#
# Two more ways in, decided 3 Oct 2026. Both obey the SAME fail-closed shape as
# the provider switches above: the word `off` turns a provider off, an unset
# line is also off, and `on` with any of its ids or secrets empty REFUSES TO
# START. A half-configured provider must never present a button that cannot
# work -- the person who presses it has no way to tell a broken deployment
# from a rejected account.
#
# The security rule these feed lives in services/account/src/federated-identity.ts:
# a provider may claim an ALREADY EXISTING account only when the provider says
# it verified the email address. Nothing written in this file relaxes that.

# off | on
C7_GOOGLE_SIGN_IN=off
# The three OAuth client ids of Google Cloud project `consummate-7` (project
# number 692573915541), created 3 Oct 2026. They are PUBLIC: the mobile ones
# are compiled into the APK and the web one is served to every browser, which
# is why they are written out here rather than left blank for the founder.
# An id token is accepted only when its `aud` is one of these three AND its
# issuer is Google -- one app's token must not open another app's door.
C7_GOOGLE_WEB_CLIENT_ID=692573915541-13t0122j4bd8vkgkainvh91cjt9vfdil.apps.googleusercontent.com
C7_GOOGLE_ANDROID_CLIENT_ID=692573915541-sbq8ila7tjkptd9ueqfdan9n6gm5tb81.apps.googleusercontent.com
C7_GOOGLE_IOS_CLIENT_ID=692573915541-05d8gnhk6b9s7mvkqk4vg169cr3qe39n.apps.googleusercontent.com
#
# THERE IS NO GOOGLE SECRET HERE, and that is a choice rather than an omission.
# We want identity and nothing else from Google -- no calendar, no contacts,
# no offline access -- so the web side takes an ID TOKEN and verifies it
# against Google's published keys, exactly as the mobile apps do. The
# authorization-code flow would need a client secret to exchange, which is one
# more secret to install, rotate and leak for a capability we never use.
# The account service holds no Google credential of any kind.

# off | on. The four applications live under KingsChat project "Videofy Live"
# (8cad61f5-7d9a-4c06-a97a-bc0480b27f3c), scope `profile` only; all four were
# APPROVED on 5 Oct 2026 and carry the client ids below. The switch still ships
# `off`, and flips on the day the routes that read these actually exist --
# never before, because a button that cannot work is worse than no button.
# `on` with any value below empty refuses to start.
C7_KINGSCHAT_SIGN_IN=off
# API base. Note this is connect.kingsch.at, NOT the developer portal's host.
C7_KINGSCHAT_BASE_URL=https://connect.kingsch.at
# The PROJECT api key, sent as the `api-key` header when reading a profile.
# One key for all four applications, and the ONLY KingsChat secret there is.
# [founder, from the project page -- never commit a populated copy]
C7_KINGSCHAT_API_KEY=
# Per-application client ids, issued on approval. The web one belongs to the
# application whose redirect url is https://staging.consummate7.com/auth/oauth/kingschat/callback.
C7_KINGSCHAT_WEB_CLIENT_ID=07042a39-4f11-4bf8-a92b-78a3b952d56c
C7_KINGSCHAT_ANDROID_CLIENT_ID=df610edb-80bb-4839-b9ba-09abc908f4a3
C7_KINGSCHAT_IOS_CLIENT_ID=9f37b8a1-2133-427c-887d-132afdb07663
#
# WHY THERE IS NO CLIENT SECRET, and what carries the weight instead.
# KingsChat's token exchange takes grant_type, client_id and code, and NOTHING
# that proves the caller is us -- so a stolen authorization code is redeemable
# by whoever holds it. Three things keep that from being a way in, and all
# three are ours to get right:
#   - delivery is Form POST, so the code arrives in a request body rather than
#     a query string, and never reaches browser history, a Referer header or
#     an access log;
#   - the callback MUST reject any response whose `state` it did not issue and
#     has not already consumed -- there is no PKCE here to fall back on;
#   - the code is single-use and must be exchanged on sight, never stored.
