# Videofy Live — account service. NAMES ONLY. Never commit a populated copy.
#
# Installed to /etc/videofy/account.env, mode 0600, owner root, group videofy.

ACCOUNT_PORT=3006
# Loopback: reached through Caddy at /auth/*.
ACCOUNT_HOST=127.0.0.1

# Signs sessions. MUST be byte-identical to the gateway's.
VIDEOFY_AUTH_SECRET=

# development | staging | production
#
# REQUIRED. Anything unrecognised -- including absent -- is treated as
# production, and the service then REFUSES TO START while any verification
# channel is configured with a synthetic provider. That is deliberate: a
# synthetic provider delivers nothing and would mark accounts verified without
# any verification having happened. A typo here must fail loudly at boot rather
# than quietly enable it.
C7_ENVIRONMENT=staging

# Shared secret the identity provider signs its callbacks with. Absent, the
# callback route refuses everything rather than accepting unsigned results.
C7_IDENTITY_CALLBACK_SECRET=

# --- where accounts live -----------------------------------------------------
#
# file | postgres
#
# `file` is a DEVELOPMENT PROTOTYPE: password hashes unencrypted on disk, every
# account rewritten on every write, and no way to survive the box. It is
# REFUSED outright when C7_ENVIRONMENT=production.
#
# Chosen explicitly rather than inferred from whether DATABASE_URL is set,
# because a missing variable would then silently downgrade a real deployment to
# a JSON file and look perfectly healthy doing it.
C7_ACCOUNT_STORE=file

# Required when C7_ACCOUNT_STORE=postgres. There is NO in-memory fallback: the
# service refuses to start rather than accepting registrations it will forget.
# Format: postgres://user:password@host:5432/database
DATABASE_URL=

# --- verification delivery -------------------------------------------------
#
# Selection throws on anything ambiguous: an unrecognised name, a missing
# credential, or synthetic while the environment is production. A typo must not
# resolve to a default, because every one of those failures ends the same way --
# a system that believes it verified somebody.

# synthetic | resend
C7_EMAIL_PROVIDER=synthetic
RESEND_API_KEY=
# The verified sending identity, e.g. "Consummate 7 <verify@yourdomain>".
C7_EMAIL_FROM=
# Absolute scheme://host with no path. Verification links are built from THIS,
# never from a request header -- a link built from a Host header mails an
# attacker's domain to a real user's inbox with the token attached.
C7_PUBLIC_ORIGIN=https://staging.consummate7.com

# synthetic | termii
C7_PHONE_PROVIDER=synthetic
TERMII_API_KEY=
# The approved sender id or device name on the Termii account.
TERMII_SENDER_ID=
# Termii documents the path as {BASE_URL}/api/sms/send and the base is account
# and region specific, so it is REQUIRED rather than assumed.
TERMII_BASE_URL=
# generic | dnd  ('dnd' reaches numbers on the do-not-disturb list)
TERMII_CHANNEL=generic
