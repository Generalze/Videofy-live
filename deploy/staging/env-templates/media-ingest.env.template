# Videofy Live — media ingest. NAMES ONLY. Never commit a populated copy.
#
# THIS FILE HOLDS EVERY COMMERCIAL CREDENTIAL. It is the only process that talks
# to Deepgram, Google or ElevenLabs, which is precisely why it is the process
# that must never face the internet.
#
# Installed to /etc/videofy/media-ingest.env, mode 0600, owner root, group videofy.

INGEST_PORT=3002
# Loopback. Reaching this service from another host must require saying so.
INGEST_HOST=127.0.0.1

# MUST match the gateway's.
INTERNAL_WEBRTC_TOKEN=

# --- programme control (the Operator console's routes) ---
# Verifies the C7 session the console presents as a bearer. MUST match the
# account service's and the gateway's, or an operator who signed in cannot
# pause their own programme and nothing explains why.
VIDEOFY_AUTH_SECRET=
# Who may operate. MUST be the same list as the gateway's: comma-separated
# account ids. Unset or empty means NOBODY can operate -- programme control
# refuses every account, and the boot log says so.
OPERATOR_CONSOLE_ACCOUNT_IDS=

# --- realtime (live) providers ---
# off | mock | deepgram-nova | deepgram-flux
STREAMING_TRANSCRIPTION_PROVIDER=
# off | mock | elevenlabs   ('off' means captions only -- no spoken translation)
STREAMING_SYNTHESIS_PROVIDER=

# --- commercial credentials (leave EMPTY until the owner supplies them) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL=

# Google: ADC is the authentication abstraction. GOOGLE_APPLICATION_CREDENTIALS
# is ONE optional source of it -- a Workload Identity Federation deployment sets
# no such variable. Set it only for the service-account-JSON fallback.
GOOGLE_TRANSLATE_PROJECT_ID=
GOOGLE_CLOUD_QUOTA_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# TTS only. Azure transcription and translation are unverified here.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

AUDIO_CHUNK_DIR=/srv/videofy/uploads/audio-chunks
# Writable state lives OUTSIDE the code tree; the unit makes the code tree
# read-only and only /srv/videofy/{state,uploads} writable.
MEDIA_INGEST_UPLOAD_DIR=/srv/videofy/uploads/media-ingest
# Also needed HERE, not only on the gateway: media-ingest creates this
# directory at startup and exits if it cannot.
WEBRTC_AUDIO_CHUNK_STAGING_DIR=/srv/videofy/uploads/webrtc-staging

# The origin a BROWSER uses to fetch generated audio. Loopback here means
# every client resolves it to itself and playback fails with MediaError 4.
# Behind the staging proxy this is the public origin plus the /media prefix.
MEDIA_INGEST_PUBLIC_URL=
GATEWAY_URL=http://127.0.0.1:3001
AI_RUNTIME_PROFILE=
LOG_LEVEL=info
