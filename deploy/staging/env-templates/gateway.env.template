# Videofy Live — realtime gateway. NAMES ONLY. Never commit a populated copy.
#
# Installed to /etc/videofy/gateway.env, mode 0600, owner root, group videofy.

GATEWAY_PORT=3001
# Loopback: the gateway is reached only through Caddy.
GATEWAY_HOST=127.0.0.1

MEDIA_INGEST_URL=http://127.0.0.1:3002
# Absent means the live path is NOT cut over. Under a commercial profile that is
# a refusal, not a fallback -- see AI_RUNTIME_PROFILE below.
MEDIA_INGEST_REALTIME_INGRESS_URL=ws://127.0.0.1:3002/internal/media/ingress/v1

# Shared internal credential. MUST be byte-identical to media-ingest's.
INTERNAL_WEBRTC_TOKEN=

# Signs account sessions. MUST match the account service's.
VIDEOFY_AUTH_SECRET=
CONNECT_AUTH_SECRET=

# commercial-cloud | commercial-local | development-demo | videofy-native
#
# This decides what an absent realtime ingress MEANS. Under a commercial
# profile a live call is REFUSED rather than silently downgraded to the batch
# pipeline -- a downgrade looks healthy from outside and is discovered by
# reading a bandwidth bill.
AI_RUNTIME_PROFILE=

WEBRTC_AUDIO_CHUNK_STAGING_DIR=/srv/videofy/uploads/webrtc-staging
CALL_TRANSCRIPT_LOG_DIR=/srv/videofy/state/call-transcripts
# JSON, not a comma-separated list. Both the gateway and the browser parse
# this with JSON.parse and fall back to [] on failure, so a malformed value
# behaves EXACTLY like an unset one -- no error, no log line, and calls that
# negotiate successfully and then die with ice-connection-failure.
# Example: [{"urls":["stun:stun.l.google.com:19302"]}]
WEBRTC_ICE_SERVERS=
# Salt for deriving each operator's channel id from their account id.
#
# SET IT ONCE AND NEVER CHANGE IT. Channel ids appear in the links operators
# hand out; changing this salt silently invalidates every link anybody has ever
# shared. It is not a secret to rotate -- it exists so that knowing an account
# id does not let somebody compute its channel id.
#
# Left empty, the gateway warns at startup and uses a built-in value. Links
# still work; the correlation property is simply absent.
# Generate with: openssl rand -hex 16
CHANNEL_ID_SALT=

LOG_LEVEL=info

# WHERE A PROTECTED PROGRAMME'S MEDIA IS HELD, named rather than derived.
#
# Both the gateway and the media service read THIS variable. The gateway's
# contribution encoder writes the segments; the media service's cursor,
# retention and egress read them. They are two processes over one directory, so
# a second spelling of the path is two services agreeing about nothing -- the
# encoder filling a spool nothing publishes from, behind an empty manifest and
# a healthy console.
#
# It lives under the STATE tree, not the code tree: the unit runs with
# ProtectSystem=strict and only {state,uploads} are in ReadWritePaths, so a
# path derived from the working directory is read-only to the service however
# it looks from a shell.
#
# Unset means this deployment holds no protected media, which is said at boot.
PROGRAMME_MEDIA_SPOOL=/srv/videofy/state/programme-media
# The rate capacity is checked against before a protected run starts. An
# ESTIMATE: the encoder runs at constant quality, so the real figure only
# exists once a run produces one, and the runtime monitor uses that instead.
PROGRAMME_SPOOL_BITRATE_BPS=3500000
# How many protected broadcasts this deployment may hold at once. The disk
# requirement multiplies by this.
PROGRAMME_SPOOL_CONCURRENT_RUNS=1
