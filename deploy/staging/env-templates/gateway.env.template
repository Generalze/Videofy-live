# Videofy Live — realtime gateway. NAMES ONLY. Never commit a populated copy.
#
# Installed to /etc/videofy/gateway.env, mode 0600, owner root, group videofy.

GATEWAY_PORT=3001
# Loopback: the gateway is reached only through Caddy.
GATEWAY_HOST=127.0.0.1

MEDIA_INGEST_URL=http://127.0.0.1:3002
# Absent means the live path is NOT cut over. Under a commercial profile that is
# a refusal, not a fallback -- see AI_RUNTIME_PROFILE below.
MEDIA_INGEST_REALTIME_INGRESS_URL=ws://127.0.0.1:3002/internal/media/ingress/v1

# Shared internal credential. MUST be byte-identical to media-ingest's.
INTERNAL_WEBRTC_TOKEN=

# Signs account sessions. MUST match the account service's.
VIDEOFY_AUTH_SECRET=
CONNECT_AUTH_SECRET=

# commercial-cloud | commercial-local | development-demo | videofy-native
#
# This decides what an absent realtime ingress MEANS. Under a commercial
# profile a live call is REFUSED rather than silently downgraded to the batch
# pipeline -- a downgrade looks healthy from outside and is discovered by
# reading a bandwidth bill.
AI_RUNTIME_PROFILE=

WEBRTC_AUDIO_CHUNK_STAGING_DIR=/srv/videofy/uploads/webrtc-staging
CALL_TRANSCRIPT_LOG_DIR=/srv/videofy/state/call-transcripts
WEBRTC_ICE_SERVERS=
LOG_LEVEL=info
