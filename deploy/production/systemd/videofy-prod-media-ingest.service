[Unit]
Description=Videofy Live media ingest (production; holds provider credentials)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=videofy
Group=videofy
WorkingDirectory=/srv/videofy-prod/app/services/media-ingest
# Names come from this file; VALUES never appear in the unit, in the repository,
# or in journald. 0640 root:videofy: the service user reads it, nobody else.
EnvironmentFile=/etc/videofy-prod/media-ingest.env
# This service sets rootDir to the monorepo root, so tsc mirrors the repo
# layout under dist/. The entry is nested; it is not dist/index.js.
ExecStart=/usr/bin/node dist/services/media-ingest/src/index.js

KillSignal=SIGTERM
TimeoutStopSec=25

# THE RESTART STORM THIS UNIT ONCE PRODUCED, AND WHY IT COULD.
#
# With Restart=on-failure and RestartSec=3, systemd's DEFAULT rate limit --
# 5 starts in 10 seconds -- can never be reached: only about three attempts fit
# in the window. So a service that fails instantly at startup restarts for
# ever, silently. This unit did exactly that 106,722 times while the platform
# reported healthy, because nothing above it distinguished "the process was
# started" from "the process is running".
#
# The limit below CAN be reached. Ten failures inside five minutes stops the
# unit in the `failed` state, where `systemctl --failed` and the host's own
# `degraded` status both show it. A transient fault still recovers -- the
# backoff gives a slow dependency time to appear -- but a configuration that
# can never work stops asking.
StartLimitIntervalSec=300
StartLimitBurst=10

Restart=on-failure
RestartSec=3
# Widen the gap as failures repeat, so a dependency that is merely slow is not
# hammered, and a storm is quieter while it lasts.
RestartSteps=5
RestartMaxDelaySec=60

# Least privilege, and PRODUCTION'S OWN directories only. The shared model
# cache (/var/lib/videofy/models) and Python runtime (/opt/videofy-ai) are
# deliberately NOT writable: identical bytes, read by both environments.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/videofy-prod/state /srv/videofy-prod/uploads
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=videofy-prod-media-ingest

[Install]
WantedBy=multi-user.target
