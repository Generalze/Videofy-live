# Videofy Live -- PRODUCTION media ingest. NAMES ONLY. Never commit a populated copy.
#
# THIS FILE HOLDS EVERY COMMERCIAL CREDENTIAL. It is the only process that talks
# to Deepgram, ElevenLabs, Azure or Google, which is why it never faces the internet.
#
# Installed to /etc/videofy-prod/media-ingest.env, mode 0640, owner root, group videofy.

INGEST_PORT=3102
# Loopback. Reaching this service from another host must require saying so.
INGEST_HOST=127.0.0.1

# development | staging | production. Read by the programme-route boot guard.
C7_ENVIRONMENT=production

# MUST match the gateway's and the account's. [install.sh]
INTERNAL_WEBRTC_TOKEN=
# Personal-voice endpoints verify sessions with this; must match the account's. [install.sh]
VIDEOFY_AUTH_SECRET=
# --- PRODUCTION OPERATOR ALLOWLIST -- FAIL-CLOSED, STARTS EMPTY -------------
# FOUNDER RULING, LOCKED 30 Aug 2026: "Programme control requires an
# authenticated C7 session AND a production operator entitlement derived
# SERVER-SIDE from the session (never a client-supplied accountId). Production
# operator allowlist starts MINIMAL and FAIL-CLOSED (empty template; the
# founder fills it on the box; no test/QA/staging accounts; 'verified C7
# identity' is NOT 'production operator')."
#
#   EMPTY MEANS NOBODY OPERATES. That is the correct shipped state, not an
#   oversight to be tidied up: an allowlist that arrives pre-filled is an
#   allowlist nobody had to decide.
#
#   The value is the founder-designated production operator, plus AT MOST ONE
#   approved backup. Comma-separated production account ids.
#
#   NO staging account. NO QA or test account. NO account created to try
#   something. Those ids exist in a different database and mean nothing here,
#   and an id pasted from a staging psql session is the exact mistake this
#   comment exists to stop.
#
#   The SAME list must be set in BOTH /etc/videofy-prod/gateway.env and
#   /etc/videofy-prod/media-ingest.env -- the gateway admits the console, and
#   media-ingest independently admits programme control. One without the other
#   is either a console that cannot start a programme or a programme control
#   that admits somebody the console does not.
#
#   Programme control here is microphone/sessions and sessions/:id/*: the
#   routes that put audio on the platform. Filled by the founder ON THE BOX
#   after the first production sign-up, then
#   `sudo systemctl restart videofy-prod-gateway videofy-prod-media-ingest`.
OPERATOR_CONSOLE_ACCOUNT_IDS=

# The PRODUCTION gateway and public origin.
GATEWAY_URL=http://127.0.0.1:3101
MEDIA_INGEST_PUBLIC_URL=https://consummate7.com/media

# commercial-cloud | commercial-local | development-demo | videofy-native
AI_RUNTIME_PROFILE=

# --- batch (uploaded programme) providers ---
# mock | faster-whisper | deepgram ...   (what staging runs: mock)
TRANSCRIPTION_PROVIDER=
# opus-mt (local, offline models under HF_HOME)
TRANSLATION_PROVIDER=opus-mt
# mock | piper | elevenlabs | azure ...
TEXT_TO_SPEECH_PROVIDER=

# --- realtime (live) providers ---
# off | mock | deepgram-nova | deepgram-flux
STREAMING_TRANSCRIPTION_PROVIDER=
# off | mock | elevenlabs | chain   ('off' = captions only)
STREAMING_SYNTHESIS_PROVIDER=

# --- commercial credentials [founder] -- absent means that provider is not selectable ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL=
# TTS only; the voice must exist in the region or Azure answers 400 with no body.
# Azure is ALSO the one named fallback for ha/ig/yo/pcm; see 9jaLingo below.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_DEFAULT_VOICE_ID=

# --- 9jaLingo: Hausa, Igbo, Yoruba, Nigerian Pidgin (ha/ig/yo/pcm) ----------
# ACTIVATION IS ONE LINE. Paste the key below and restart; everything else has
# a published default read from the official `naijalingo` npm SDK (0.1.3).
#
# WHY IT MATTERS MORE THAN THE OTHER KEYS. ElevenLabs and Azure both ACCEPT
# these four languages and answer HTTP 200 with fluent-sounding audio that is
# wrong -- a multilingual voice reading unfamiliar orthography with the
# phonology it already has. No status code, byte count or latency reveals it;
# only a speaker of the language can. So leaving this blank does not disable a
# feature, it silently downgrades one, and the service says so at WARN on boot
# and on /health rather than letting it pass as normal.
#
# ROUTING for ha/ig/yo/pcm is 9jaLingo, then AZURE, then NOTHING (founder
# ruling, 30 Aug 2026). ElevenLabs is deliberately excluded from those four.
NAIJALINGO_API_KEY=
#
# Everything below is OPTIONAL. Blank means "use the published default".
#   NAIJALINGO_BASE_URL           default https://api.9jalingo.org
#   NAIJALINGO_MODEL              default 9jalingo-tts-1
#   NAIJALINGO_AUTH_HEADER        default x-api-key   (raw key, NO scheme)
#   NAIJALINGO_AUTH_SCHEME        default empty       (set only if the vendor
#                                 changes its handshake before its docs do; a
#                                 wrong header returns the same 401 as a wrong
#                                 key, which is why the error names the header)
NAIJALINGO_BASE_URL=
NAIJALINGO_MODEL=
NAIJALINGO_AUTH_HEADER=
NAIJALINGO_AUTH_SCHEME=
#
# A VOICE IS A SPEAKER ID, NEVER A LANGUAGE CODE. `yo` is a language; the voice
# is `adeola_yo`. The vendor's own SDK throws for this and so does the adapter,
# by name, because the two fields sit next to each other and hold similar
# strings. The boot preflight lists the speaker ids THIS key may actually use,
# per language -- that is the honest check a default cannot give you.
#   NAIJALINGO_VOICE_BY_LANGUAGE  e.g. yo=adeola_yo,ig=adaeze_ig,ha=aisha_ha,pcm=ada_pcm
#   NAIJALINGO_VOICE_IDS          platformVoiceId=speaker_id,... (per Videofy voice)
#   NAIJALINGO_DEFAULT_VOICE      last-resort speaker id
NAIJALINGO_VOICE_BY_LANGUAGE=
NAIJALINGO_VOICE_IDS=
NAIJALINGO_DEFAULT_VOICE=
#
# LEAVE THESE TWO ALONE unless the PCM sample rate has actually been MEASURED.
# The vendor publishes no rate for its raw `pcm` output, and a wrong rate does
# not fail -- it plays at the wrong pitch in a language the reviewer may not
# speak. The adapter therefore asks for `wav`, which declares its own rate in
# its RIFF header, and reads it. `pcm` here REFUSES to start without the rate.
#   NAIJALINGO_RESPONSE_FORMAT    wav (default) | pcm
#   NAIJALINGO_SAMPLE_RATE        required ONLY when the format is pcm
NAIJALINGO_RESPONSE_FORMAT=
NAIJALINGO_SAMPLE_RATE=
# Google: ADC. Set the credentials path only for the service-account-JSON fallback.
GOOGLE_TRANSLATE_PROJECT_ID=
GOOGLE_CLOUD_QUOTA_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- local AI runtime and models: SHARED READ-ONLY with staging ---
# The same wheels and the same 2.7 GB of Opus-MT weights serve both environments;
# the unit grants no write access to either path, and HF_HUB_OFFLINE stops any
# attempt to fetch. Separate copies would double the disk for identical bytes.
AI_PYTHON_EXECUTABLE=/opt/videofy-ai/bin/python
OPUS_MT_PYTHON=/opt/videofy-ai/bin/python
OPUS_MT_MODEL_CACHE_DIR=/var/lib/videofy/models
OPUS_MT_ALLOW_MODEL_DOWNLOAD=false
HF_HOME=/var/lib/videofy/models
HF_HUB_OFFLINE=1
SILERO_VAD_MODEL_PATH=/var/lib/videofy/models/silero_vad.onnx

# --- own writable directories (outside the code tree; the unit makes the tree read-only) ---
AUDIO_CHUNK_DIR=/srv/videofy-prod/uploads/audio-chunks
MEDIA_INGEST_UPLOAD_DIR=/srv/videofy-prod/uploads/media-ingest
# Also needed HERE: media-ingest creates this directory at startup and exits if it cannot.
WEBRTC_AUDIO_CHUNK_STAGING_DIR=/srv/videofy-prod/uploads/webrtc-staging

LOG_LEVEL=info
