# Videofy Live -- PRODUCTION media ingest. NAMES ONLY. Never commit a populated copy.
#
# THIS FILE HOLDS EVERY COMMERCIAL CREDENTIAL. It is the only process that talks
# to Deepgram, ElevenLabs, Azure or Google, which is why it never faces the internet.
#
# Installed to /etc/videofy-prod/media-ingest.env, mode 0640, owner root, group videofy.

INGEST_PORT=3102
# Loopback. Reaching this service from another host must require saying so.
INGEST_HOST=127.0.0.1

# development | staging | production. Read by the programme-route boot guard.
C7_ENVIRONMENT=production

# MUST match the gateway's and the account's. [install.sh]
INTERNAL_WEBRTC_TOKEN=
# Personal-voice endpoints verify sessions with this; must match the account's. [install.sh]
VIDEOFY_AUTH_SECRET=
# --- PRODUCTION OPERATOR ALLOWLIST -- FAIL-CLOSED, STARTS EMPTY -------------
# FOUNDER RULING, LOCKED 30 Aug 2026: "Programme control requires an
# authenticated C7 session AND a production operator entitlement derived
# SERVER-SIDE from the session (never a client-supplied accountId). Production
# operator allowlist starts MINIMAL and FAIL-CLOSED (empty template; the
# founder fills it on the box; no test/QA/staging accounts; 'verified C7
# identity' is NOT 'production operator')."
#
#   EMPTY MEANS NOBODY OPERATES. That is the correct shipped state, not an
#   oversight to be tidied up: an allowlist that arrives pre-filled is an
#   allowlist nobody had to decide.
#
#   The value is the founder-designated production operator, plus AT MOST ONE
#   approved backup. Comma-separated production account ids.
#
#   NO staging account. NO QA or test account. NO account created to try
#   something. Those ids exist in a different database and mean nothing here,
#   and an id pasted from a staging psql session is the exact mistake this
#   comment exists to stop.
#
#   The SAME list must be set in BOTH /etc/videofy-prod/gateway.env and
#   /etc/videofy-prod/media-ingest.env -- the gateway admits the console, and
#   media-ingest independently admits programme control. One without the other
#   is either a console that cannot start a programme or a programme control
#   that admits somebody the console does not.
#
#   Programme control here is microphone/sessions and sessions/:id/*: the
#   routes that put audio on the platform. Filled by the founder ON THE BOX
#   after the first production sign-up, then
#   `sudo systemctl restart videofy-prod-gateway videofy-prod-media-ingest`.
OPERATOR_CONSOLE_ACCOUNT_IDS=

# The PRODUCTION gateway and public origin.
GATEWAY_URL=http://127.0.0.1:3101
MEDIA_INGEST_PUBLIC_URL=https://consummate7.com/media

# commercial-cloud | commercial-local | development-demo | videofy-native
#
# FOUNDER RULING, 30 Aug 2026: "most details used for staging are commercial
# providers" and "anything that needs to be substituted should be". Production
# therefore runs the COMMERCIAL profile. Staging keeps development-demo, and its
# TRANSCRIPTION_PROVIDER=mock does not follow it here.
#
# THIS VALUE IS GATED, NOT DECLARATIVE. media-ingest asks the registry
# (commercialProfileBlockers, minimumStage 'certified') whether a commercial
# profile may start at all, and refuses with the reason attached if not. Setting
# this line does not grant anything; it asks a question the registry answers.
# C-AI1.2 answered the EVIDENCE half of that question on 2026-08-30 -- Deepgram,
# ElevenLabs, Azure and 9jaLingo are now certified on recorded multi-sample
# benchmarks, and Google is not, because its credentials were absent and it was
# therefore never exercised.
AI_RUNTIME_PROFILE=commercial-cloud

# --- batch (uploaded programme) providers ---
#
# THE BATCH PATH IS THE UPLOADED-PROGRAMME PATH AND NOTHING ELSE. The LIVE path
# is the two STREAMING_* lines below, is entirely separate, and is the one that
# carries calls and live programmes.
#
# mock | faster-whisper
#
#   MOCK IS FORBIDDEN HERE. It returns a fabricated transcript and reports
#   success, so an uploaded programme would produce confident, invented captions
#   with nothing anywhere reporting a fault. That is the exact failure the
#   founder ruled out, and it is worse than having no batch path at all.
#
#   `faster-whisper` is therefore the value, and the honest statement that goes
#   with it is this: AS OF 30 Aug 2026 THE PYTHON RUNTIME AT
#   AI_PYTHON_EXECUTABLE DOES NOT SHIP faster_whisper AND NO WHISPER WEIGHTS ARE
#   CACHED UNDER HF_HOME (checked on the box; only the Opus-MT models and
#   silero_vad.onnx are present). So uploaded-programme transcription will FAIL
#   when it is first attempted, loudly, naming the missing module.
#
#   THAT IS THE INTENDED STATE and it was chosen deliberately over the
#   alternative. Of the two permitted values, one fails where somebody can see
#   it and the other succeeds while inventing words. A path that is unavailable
#   and says so can be fixed; a path that lies cannot even be noticed.
#
#   TO MAKE IT AVAILABLE: install faster-whisper into /opt/videofy-ai and cache
#   a model under HF_HOME (HF_HUB_OFFLINE=1 means it will not fetch one at run
#   time). Until then, do not upload programmes to production.
TRANSCRIPTION_PROVIDER=faster-whisper
# opus-mt (local, offline models under HF_HOME). Benchmarked on staging
# 2026-08-30 through the live seam: 5/5 en->es sentences, median 6541 ms.
# Present and working on this box; the models are shared read-only with staging.
TRANSLATION_PROVIDER=opus-mt
# mock | piper | piper+mms
#
#   Same ruling and the same reasoning as TRANSCRIPTION_PROVIDER above: mock
#   would return synthetic audio and report success. `piper` is the honest
#   value, and Piper is likewise NOT INSTALLED on this box today -- so the batch
#   synthesis half of the uploaded-programme pipeline is unavailable alongside
#   the batch transcription half. One missing runtime, one unavailable path,
#   stated once rather than discovered twice.
#
#   Commercial TTS does NOT belong on this line. ElevenLabs, Azure and 9jaLingo
#   are reached through STREAMING_SYNTHESIS_PROVIDER below, which is the live
#   path and is separately configured.
TEXT_TO_SPEECH_PROVIDER=piper

# --- realtime (live) providers -- THE PATH THAT CARRIES CALLS ---------------
# off | mock | deepgram-nova | deepgram-flux
#
#   `deepgram-nova`, matching staging and matching the evidence. C-AI1.2 on
#   2026-08-30 benchmarked nova-3 streaming through the deployed adapter from
#   staging: 5/5 samples, time to first transcript min 1010 / median 1055 /
#   max 1056 ms, on 7.88 s of clean synthetic English fed at real time. That
#   figure is a FLOOR -- clean speech, one language -- and is not a promise
#   about a noisy room or an accented speaker.
#
#   NOT `deepgram-flux`. Flux speaks a different protocol (Listen v2, turn
#   events) and holds only a single-run existence proof from 2026-08-22. It has
#   never been benchmarked and must not be selected here on the strength of its
#   vendor sharing a name with the model that was.
STREAMING_TRANSCRIPTION_PROVIDER=deepgram-nova
# off | mock | elevenlabs | azure | chain   ('off' = captions only)
#
#   `chain`, which is what makes the Nigerian-language ruling real: for
#   ha/ig/yo/pcm the order is 9jaLingo, then Azure, then nothing, and ElevenLabs
#   is deliberately excluded from those four. A single-vendor value here would
#   silently discard that ordering.
#
#   Benchmarked 2026-08-30, five samples each, through the deployed adapters:
#   ElevenLabs eleven_flash_v2_5 first chunk median 123 ms; Azure
#   cognitiveservices-v1 first chunk median 144 ms; 9jaLingo whole-request
#   median 6470-7891 ms depending on language, and it SCALES TO ZERO -- the
#   first request after an idle period is refused with a 503 that takes minutes
#   to clear. Nigerian-language audio falls to Azure while that is true, and
#   Azure mispronounces those languages. That is a real product consequence, not
#   a footnote.
STREAMING_SYNTHESIS_PROVIDER=chain

# --- commercial credentials [founder] -- absent means that provider is not selectable ---
#
# WHY MEDIA-INGEST STILL WILL NOT START, AS OF 30 Aug 2026, AND IT IS TWO
# SEPARATE THINGS. Measured against the certified registry rather than guessed:
#
#   1. FOUNDER INPUT. Every key below is empty in /etc/videofy-prod/media-ingest.env,
#      so every provider resolves to `provider-operationally-disabled` with its
#      missing variable NAMED. Pasting DEEPGRAM_API_KEY alone clears this for all
#      three service categories, because Deepgram is the only registered
#      commercial transcription provider and transcription is what each category
#      gates on.
#
#   2. ENGINEERING, AND NOT THE FOUNDER'S TO FIX. Even with every key present,
#      the profile gate still refuses, with one issue left: `health-not-serving`.
#      commercialProfileBlockers passes NO health signal, health defaults to
#      `unknown`, and `unknown` deliberately does not accept traffic -- an
#      unprobed provider is not a healthy one. Nothing probes a vendor before
#      that check runs, so the value can never be anything but `unknown` at boot
#      and the gate can never pass. The two halves were each built correctly and
#      the seam between them was never joined.
#
#      DO NOT "FIX" THIS BY PASSING health: 'healthy'. That would assert a probe
#      that did not happen, which is the mock-success path the founder ruled out
#      wearing different clothes. The fix is a real boot-time probe whose result
#      feeds the gate.
#
# The certification half of the gate is DONE and is no longer a blocker:
# integration-stage-insufficient no longer appears for any provider.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL=
# TTS only; the voice must exist in the region or Azure answers 400 with no body.
# Azure is ALSO the one named fallback for ha/ig/yo/pcm; see 9jaLingo below.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_DEFAULT_VOICE_ID=

# --- 9jaLingo: Hausa, Igbo, Yoruba, Nigerian Pidgin (ha/ig/yo/pcm) ----------
# ACTIVATION IS ONE LINE. Paste the key below and restart; everything else has
# a published default read from the official `naijalingo` npm SDK (0.1.3).
#
# WHY IT MATTERS MORE THAN THE OTHER KEYS. ElevenLabs and Azure both ACCEPT
# these four languages and answer HTTP 200 with fluent-sounding audio that is
# wrong -- a multilingual voice reading unfamiliar orthography with the
# phonology it already has. No status code, byte count or latency reveals it;
# only a speaker of the language can. So leaving this blank does not disable a
# feature, it silently downgrades one, and the service says so at WARN on boot
# and on /health rather than letting it pass as normal.
#
# ROUTING for ha/ig/yo/pcm is 9jaLingo, then AZURE, then NOTHING (founder
# ruling, 30 Aug 2026). ElevenLabs is deliberately excluded from those four.
NAIJALINGO_API_KEY=
#
# Everything below is OPTIONAL. Blank means "use the published default".
#   NAIJALINGO_BASE_URL           default https://api.9jalingo.org
#   NAIJALINGO_MODEL              default 9jalingo-tts-1
#   NAIJALINGO_AUTH_HEADER        default x-api-key   (raw key, NO scheme)
#   NAIJALINGO_AUTH_SCHEME        default empty       (set only if the vendor
#                                 changes its handshake before its docs do; a
#                                 wrong header returns the same 401 as a wrong
#                                 key, which is why the error names the header)
NAIJALINGO_BASE_URL=
NAIJALINGO_MODEL=
NAIJALINGO_AUTH_HEADER=
NAIJALINGO_AUTH_SCHEME=
#
# A VOICE IS A SPEAKER ID, NEVER A LANGUAGE CODE. `yo` is a language; the voice
# is `adeola_yo`. The vendor's own SDK throws for this and so does the adapter,
# by name, because the two fields sit next to each other and hold similar
# strings. The boot preflight lists the speaker ids THIS key may actually use,
# per language -- that is the honest check a default cannot give you.
#   NAIJALINGO_VOICE_BY_LANGUAGE  e.g. yo=adeola_yo,ig=adaeze_ig,ha=aisha_ha,pcm=ada_pcm
#   NAIJALINGO_VOICE_IDS          platformVoiceId=speaker_id,... (per Videofy voice)
#   NAIJALINGO_DEFAULT_VOICE      last-resort speaker id
NAIJALINGO_VOICE_BY_LANGUAGE=
NAIJALINGO_VOICE_IDS=
NAIJALINGO_DEFAULT_VOICE=
#
# LEAVE THESE TWO ALONE unless the PCM sample rate has actually been MEASURED.
# The vendor publishes no rate for its raw `pcm` output, and a wrong rate does
# not fail -- it plays at the wrong pitch in a language the reviewer may not
# speak. The adapter therefore asks for `wav`, which declares its own rate in
# its RIFF header, and reads it. `pcm` here REFUSES to start without the rate.
#   NAIJALINGO_RESPONSE_FORMAT    wav (default) | pcm
#   NAIJALINGO_SAMPLE_RATE        required ONLY when the format is pcm
NAIJALINGO_RESPONSE_FORMAT=
NAIJALINGO_SAMPLE_RATE=
# Google: ADC. Set the credentials path only for the service-account-JSON fallback.
GOOGLE_TRANSLATE_PROJECT_ID=
GOOGLE_CLOUD_QUOTA_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- local AI runtime and models: SHARED READ-ONLY with staging ---
# The same wheels and the same 2.7 GB of Opus-MT weights serve both environments;
# the unit grants no write access to either path, and HF_HUB_OFFLINE stops any
# attempt to fetch. Separate copies would double the disk for identical bytes.
AI_PYTHON_EXECUTABLE=/opt/videofy-ai/bin/python
OPUS_MT_PYTHON=/opt/videofy-ai/bin/python
OPUS_MT_MODEL_CACHE_DIR=/var/lib/videofy/models
OPUS_MT_ALLOW_MODEL_DOWNLOAD=false
HF_HOME=/var/lib/videofy/models
HF_HUB_OFFLINE=1
SILERO_VAD_MODEL_PATH=/var/lib/videofy/models/silero_vad.onnx

# --- own writable directories (outside the code tree; the unit makes the tree read-only) ---
AUDIO_CHUNK_DIR=/srv/videofy-prod/uploads/audio-chunks
MEDIA_INGEST_UPLOAD_DIR=/srv/videofy-prod/uploads/media-ingest
# Also needed HERE: media-ingest creates this directory at startup and exits if it cannot.
WEBRTC_AUDIO_CHUNK_STAGING_DIR=/srv/videofy-prod/uploads/webrtc-staging

LOG_LEVEL=info

# WHERE A PROTECTED PROGRAMME'S MEDIA IS HELD, named rather than derived.
#
# Both the gateway and the media service read THIS variable. The gateway's
# contribution encoder writes the segments; the media service's cursor,
# retention and egress read them. They are two processes over one directory, so
# a second spelling of the path is two services agreeing about nothing -- the
# encoder filling a spool nothing publishes from, behind an empty manifest and
# a healthy console.
#
# It lives under the STATE tree, not the code tree: the unit runs with
# ProtectSystem=strict and only {state,uploads} are in ReadWritePaths, so a
# path derived from the working directory is read-only to the service however
# it looks from a shell.
#
# Unset means this deployment holds no protected media, which is said at boot.
PROGRAMME_MEDIA_SPOOL=/srv/videofy-prod/state/programme-media
# The rate capacity is checked against before a protected run starts. An
# ESTIMATE: the encoder runs at constant quality, so the real figure only
# exists once a run produces one, and the runtime monitor uses that instead.
PROGRAMME_SPOOL_BITRATE_BPS=3500000
# How many protected broadcasts this deployment may hold at once. The disk
# requirement multiplies by this.
PROGRAMME_SPOOL_CONCURRENT_RUNS=1
