# Videofy Live -- PRODUCTION realtime gateway. NAMES ONLY. Never commit a populated copy.
#
# Installed to /etc/videofy-prod/gateway.env, mode 0640, owner root, group videofy.

GATEWAY_PORT=3101
# Loopback: the gateway is reached only through Caddy.
GATEWAY_HOST=127.0.0.1

# The PRODUCTION media-ingest and account, never staging's (3002/3006).
MEDIA_INGEST_URL=http://127.0.0.1:3102
# Absent means the live path is NOT cut over; under a commercial profile that is a refusal.
MEDIA_INGEST_REALTIME_INGRESS_URL=ws://127.0.0.1:3102/internal/media/ingress/v1
# The origin a BROWSER fetches generated audio from: public origin + /media.
MEDIA_INGEST_PUBLIC_URL=https://consummate7.com/media
ACCOUNT_SERVICE_URL=http://127.0.0.1:3106

# Shared internal credential; byte-identical in media-ingest and account. [install.sh]
INTERNAL_WEBRTC_TOKEN=
# Signs account sessions; must match the account service's. [install.sh]
VIDEOFY_AUTH_SECRET=
# Connect (embedding SDK) session secret. [install.sh]
CONNECT_AUTH_SECRET=

# commercial-cloud | commercial-local | development-demo | videofy-native
# Decides what an absent realtime ingress MEANS; commercial profiles refuse a silent downgrade.
AI_RUNTIME_PROFILE=

# Derives each operator's channel id from their account id. SET ONCE, NEVER CHANGE:
# changing it invalidates every link ever shared. [install.sh]
CHANNEL_ID_SALT=

# --- PRODUCTION OPERATOR ALLOWLIST -- FAIL-CLOSED, STARTS EMPTY -------------
# FOUNDER RULING, LOCKED 30 Aug 2026: "Programme control requires an
# authenticated C7 session AND a production operator entitlement derived
# SERVER-SIDE from the session (never a client-supplied accountId). Production
# operator allowlist starts MINIMAL and FAIL-CLOSED (empty template; the
# founder fills it on the box; no test/QA/staging accounts; 'verified C7
# identity' is NOT 'production operator')."
#
#   EMPTY MEANS NOBODY OPERATES. That is the correct shipped state, not an
#   oversight to be tidied up: an allowlist that arrives pre-filled is an
#   allowlist nobody had to decide.
#
#   The value is the founder-designated production operator, plus AT MOST ONE
#   approved backup. Comma-separated production account ids.
#
#   NO staging account. NO QA or test account. NO account created to try
#   something. Those ids exist in a different database and mean nothing here,
#   and an id pasted from a staging psql session is the exact mistake this
#   comment exists to stop.
#
#   The SAME list must be set in BOTH /etc/videofy-prod/gateway.env and
#   /etc/videofy-prod/media-ingest.env -- the gateway admits the console, and
#   media-ingest independently admits programme control. One without the other
#   is either a console that cannot start a programme or a programme control
#   that admits somebody the console does not.
#
#   Filled by the founder ON THE BOX after the first production sign-up, then
#   `sudo systemctl restart videofy-prod-gateway videofy-prod-media-ingest`.
OPERATOR_CONSOLE_ACCOUNT_IDS=

# Browser origins allowed on the socket. The apps are same-origin, so only the apex.
CORS_ORIGINS=https://consummate7.com

# Own writable directories.
WEBRTC_AUDIO_CHUNK_STAGING_DIR=/srv/videofy-prod/uploads/webrtc-staging
CALL_TRANSCRIPT_LOG_DIR=/srv/videofy-prod/state/call-transcripts

# JSON array of STUN servers handed to peers; malformed behaves EXACTLY like unset.
WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]}]

# --- TURN relay (the shared coturn on this box) ---
# FOUNDER RULING, LOCKED 30 Aug 2026: "TURN is NEVER behind the ordinary
# Cloudflare proxy: either the proven direct-origin arrangement
# (169.58.215.77) or an optional DNS-only turn.consummate7.com A record."
#
# EXACTLY TWO VALUES ARE PERMITTED HERE:
#
#   TURN_HOST=169.58.215.77            the proven direct-origin arrangement;
#                                      needs no DNS record at all
#   TURN_HOST=turn.consummate7.com     the optional arrangement; the A record
#                                      must be GREY-CLOUDED (DNS only) and
#                                      point at 169.58.215.77
#
# NEVER consummate7.com, www.consummate7.com or staging.consummate7.com. Those
# are proxied, the ordinary Cloudflare proxy carries HTTP only, and TURN over
# it never connects -- it issues a credential, hands the browser a relay URL
# that answers nothing, and every cross-NAT call pays the full ICE timeout
# while every health signal stays green.
#
# This is checked, not merely written down: deploy/lib/turn-guard.sh resolves
# whatever is set here and REFUSES the install (and fails the smoke) if it
# lands in a Cloudflare range. The gateway itself uses the value verbatim as
# the host of `turn:<host>:<port>` (services/realtime-gateway/src/
# ice-credentials.ts, readTurnConfig) and validates nothing.
TURN_HOST=169.58.215.77
TURN_PORT=3478
# Production's OWN shared secret; coturn holds it as a second static-auth-secret line. [install.sh]
TURN_STATIC_AUTH_SECRET=
# Lifetime of each minted relay credential.
TURN_TTL_SECONDS=43200

LOG_LEVEL=info

# WHERE A PROTECTED PROGRAMME'S MEDIA IS HELD, named rather than derived.
#
# Both the gateway and the media service read THIS variable. The gateway's
# contribution encoder writes the segments; the media service's cursor,
# retention and egress read them. They are two processes over one directory, so
# a second spelling of the path is two services agreeing about nothing -- the
# encoder filling a spool nothing publishes from, behind an empty manifest and
# a healthy console.
#
# It lives under the STATE tree, not the code tree: the unit runs with
# ProtectSystem=strict and only {state,uploads} are in ReadWritePaths, so a
# path derived from the working directory is read-only to the service however
# it looks from a shell.
#
# Unset means this deployment holds no protected media, which is said at boot.
PROGRAMME_MEDIA_SPOOL=/srv/videofy-prod/state/programme-media
# The rate capacity is checked against before a protected run starts. An
# ESTIMATE: the encoder runs at constant quality, so the real figure only
# exists once a run produces one, and the runtime monitor uses that instead.
PROGRAMME_SPOOL_BITRATE_BPS=3500000
# How many protected broadcasts this deployment may hold at once. The disk
# requirement multiplies by this.
PROGRAMME_SPOOL_CONCURRENT_RUNS=1
