# Videofy Live -- PRODUCTION account service. NAMES ONLY. Never commit a populated copy.
#
# Installed to /etc/videofy-prod/account.env, mode 0640, owner root, group videofy.
# Lines left empty here are filled either by deploy/production/install.sh
# (internal secrets, generated on the box) or by the founder (vendor keys).

ACCOUNT_PORT=3106
# Loopback: reached through Caddy at /auth/*. Production block is staging + 100.
ACCOUNT_HOST=127.0.0.1

# Signs sessions. MUST be byte-identical to the gateway's and media-ingest's. [install.sh]
VIDEOFY_AUTH_SECRET=
# Lets the gateway call the account service's internal routes. Same value in all three. [install.sh]
INTERNAL_WEBRTC_TOKEN=

# development | staging | production. Anything else is treated as production.
# In production the service REFUSES TO START with any synthetic provider.
C7_ENVIRONMENT=production

# file | postgres. `file` is refused in production.
C7_ACCOUNT_STORE=postgres
# postgres://videofy_prod:<generated>@127.0.0.1:5432/videofy_account_prod  [install.sh]
DATABASE_URL=

# Signature secret for identity-provider callbacks; absent, the route refuses everything. [install.sh]
C7_IDENTITY_CALLBACK_SECRET=

# Second-factor keyring, k1:<64 hex>:current. Half-configured MFA refuses to start. [install.sh]
C7_MFA_KEYRING=
# Pepper for recovery-code hashes, at least 32 characters. [install.sh]
C7_MFA_RECOVERY_PEPPER=

# Salt for hashing addresses in security events (>= 16 chars); unset omits them. [install.sh]
C7_SECURITY_TARGET_SALT=

# policyType:version pairs users must accept; EMPTY until approved policy content exists.
C7_REQUIRED_POLICIES=

# --- verification delivery: production refuses `synthetic` on BOTH channels ---
# synthetic | resend        (production: resend)
C7_EMAIL_PROVIDER=resend
# Resend API key. [founder]  Absent with resend selected: refuses to start.
RESEND_API_KEY=
# Verified sending identity, e.g. Consummate 7 <verify@consummate7.com>. [founder]
C7_EMAIL_FROM=
# Absolute scheme://host with no path; verification links are built from THIS.
C7_PUBLIC_ORIGIN=https://consummate7.com

# synthetic | termii        (production: termii -- synthetic is refused at boot)
C7_PHONE_PROVIDER=termii
# Termii API key. [founder]  Absent with termii selected: refuses to start.
TERMII_API_KEY=
# Approved sender id or device name on the Termii account. [founder]
TERMII_SENDER_ID=
# Account/region specific base, e.g. https://v3.api.termii.com. [founder]
TERMII_BASE_URL=
# generic | dnd
TERMII_CHANNEL=generic

# --- push notifications (Firebase Cloud Messaging) ---
# Firebase project id. [founder]  Absent: push is disabled, ringing falls back to sockets.
FCM_PROJECT_ID=
# Service-account JSON, installed 0640 root:videofy by the founder at this path.
FCM_SERVICE_ACCOUNT_FILE=/etc/videofy-prod/fcm-service-account.json

# --- where this environment writes ---
# Own directories; the unit makes everything else read-only.
MESSAGE_MEDIA_DIR=/var/lib/videofy-prod/message-media
AVATAR_MEDIA_DIR=/var/lib/videofy-prod/avatars
CHANNEL_MEDIA_DIR=/var/lib/videofy-prod/channel-media

# The PRODUCTION media-ingest, for voice-note and message translation.
MEDIA_INGEST_URL=http://127.0.0.1:3102

# --- platform roles ---
# Comma-separated account ids that carry the official badge. [founder, after first sign-up]
OFFICIAL_ACCOUNT_IDS=
# Comma-separated account ids allowed to operate the platform console. [founder]
PLATFORM_OPERATOR_ACCOUNT_IDS=
# ISO currency the default tariff is seeded in.
BILLING_CURRENCY=USD

# --- backups (read by backup-database.sh, not by the service) ---
# rclone remote for off-box copies, e.g. b2:c7-backups/production. Unset = local only, with a loud warning.
BACKUP_OFF_BOX_TARGET=
BACKUP_RETAIN_DAYS=14
