# Videofy Live -- PRODUCTION account service. NAMES ONLY. Never commit a populated copy.
#
# Installed to /etc/videofy-prod/account.env, mode 0640, owner root, group videofy.
# Lines left empty here are filled either by deploy/production/install.sh
# (internal secrets, generated on the box) or by the founder (vendor keys).

ACCOUNT_PORT=3106
# Loopback: reached through Caddy at /auth/*. Production block is staging + 100.
ACCOUNT_HOST=127.0.0.1

# Signs sessions. MUST be byte-identical to the gateway's and media-ingest's. [install.sh]
VIDEOFY_AUTH_SECRET=
# Lets the gateway call the account service's internal routes. Same value in all three. [install.sh]
INTERNAL_WEBRTC_TOKEN=

# development | staging | production. Anything else is treated as production.
# In production the service REFUSES TO START with any synthetic provider.
C7_ENVIRONMENT=production

# file | postgres. `file` is refused in production.
C7_ACCOUNT_STORE=postgres
# postgres://videofy_prod:<generated>@127.0.0.1:5432/videofy_account_prod  [install.sh]
DATABASE_URL=

# Signature secret for identity-provider callbacks; absent, the route refuses everything. [install.sh]
# Also refused outright while C7_IDENTITY_PROVIDER=off: no case exists to answer.
C7_IDENTITY_CALLBACK_SECRET=

# Second-factor keyring, k1:<64 hex>:current. Half-configured MFA refuses to start. [install.sh]
C7_MFA_KEYRING=
# Pepper for recovery-code hashes, at least 32 characters. [install.sh]
C7_MFA_RECOVERY_PEPPER=

# Salt for hashing addresses in security events (>= 16 chars); unset omits them. [install.sh]
C7_SECURITY_TARGET_SALT=

# policyType:version pairs users must accept; EMPTY until approved policy content exists.
C7_REQUIRED_POLICIES=

# --- the three provider switches ---
#
# Production ruling, 30 Aug 2026: "a missing provider must refuse the capability
# honestly or fail startup where the capability is mandatory -- NEVER a silent
# fall back to a synthetic/mock provider in production."
#
# So each switch below is chosen BY NAME. `synthetic` refuses to start in
# production on every channel, and LEAVING A SWITCH UNSET MEANS `synthetic` --
# it never means `off`. Switching a capability off is a word written here on
# purpose; it can never be the result of a forgotten line.
#
#   C7_EMAIL_PROVIDER     synthetic | resend            production: resend only
#   C7_PHONE_PROVIDER     synthetic | termii | off      production: termii or off
#   C7_IDENTITY_PROVIDER  synthetic | off               production: off (no vendor yet)
#
# `off` = the capability is honestly unavailable: the routes answer 503, nothing
# is sent, no case is created, and NO ACCOUNT IS EVER MARKED VERIFIED through it.
# An off component simply stays `unverified`; off is not a kind of verified.

# synthetic | resend        (production: resend. There is no `off`: email is how
# an account is verified AND recovered, so a deployment without it strands
# everybody who forgets a password.)
C7_EMAIL_PROVIDER=resend
# Resend API key. [founder]  Absent with resend selected: refuses to start.
RESEND_API_KEY=
# Verified sending identity, e.g. Consummate 7 <verify@consummate7.com>. [founder]
C7_EMAIL_FROM=
# Absolute scheme://host with no path; verification links are built from THIS.
C7_PUBLIC_ORIGIN=https://consummate7.com

# synthetic | termii | off  (production: `termii` or `off`; synthetic -- including
# the synthetic you get by deleting this line -- refuses to start.)
# Ships as `off` so the box boots before a Termii account exists: the two phone
# routes then answer 503 and phone stays `unverified`. Change to `termii` and
# fill the three variables below on the day the account is bought -- selecting
# `termii` with any of them empty refuses to start, which is deliberate.
C7_PHONE_PROVIDER=off
# Termii API key. [founder]  Absent with termii selected: refuses to start.
TERMII_API_KEY=
# Approved sender id or device name on the Termii account. [founder]
TERMII_SENDER_ID=
# Account/region specific base, e.g. https://v3.api.termii.com. [founder]
TERMII_BASE_URL=
# generic | dnd
TERMII_CHANNEL=generic

# synthetic | off           (production: `off` -- no KYC vendor has been chosen.
# `synthetic` refuses to start, and so does an unset line, which is why this one
# is written out rather than omitted.)
# `off`: /verification/identity answers 503, the provider callback is refused,
# and identity stays `unverified`. A real vendor becomes a third value here and
# nothing else in the service changes.
C7_IDENTITY_PROVIDER=off

# --- federated sign-in (Google, KingsChat) ---
#
# Two more ways in, decided 3 Oct 2026. Both obey the SAME fail-closed shape as
# the provider switches above: the word `off` turns a provider off, an unset
# line is also off, and `on` with any of its ids or secrets empty REFUSES TO
# START. A half-configured provider must never present a button that cannot
# work -- the person who presses it has no way to tell a broken deployment
# from a rejected account.
#
# The security rule these feed lives in services/account/src/federated-identity.ts:
# a provider may claim an ALREADY EXISTING account only when the provider says
# it verified the email address. Nothing written in this file relaxes that.

# off | on
C7_GOOGLE_SIGN_IN=off
# The three OAuth client ids of Google Cloud project `consummate-7` (project
# number 692573915541), created 3 Oct 2026. They are PUBLIC: the mobile ones
# are compiled into the APK and the web one is served to every browser, which
# is why they are written out here rather than left blank for the founder.
# An id token is accepted only when its `aud` is one of these three AND its
# issuer is Google -- one app's token must not open another app's door.
C7_GOOGLE_WEB_CLIENT_ID=692573915541-13t0122j4bd8vkgkainvh91cjt9vfdil.apps.googleusercontent.com
C7_GOOGLE_ANDROID_CLIENT_ID=692573915541-sbq8ila7tjkptd9ueqfdan9n6gm5tb81.apps.googleusercontent.com
C7_GOOGLE_IOS_CLIENT_ID=692573915541-05d8gnhk6b9s7mvkqk4vg169cr3qe39n.apps.googleusercontent.com
#
# THERE IS NO GOOGLE SECRET HERE, and that is a choice rather than an omission.
# We want identity and nothing else from Google -- no calendar, no contacts,
# no offline access -- so the web side takes an ID TOKEN and verifies it
# against Google's published keys, exactly as the mobile apps do. The
# authorization-code flow would need a client secret to exchange, which is one
# more secret to install, rotate and leak for a capability we never use.
# The account service holds no Google credential of any kind.

# off | on. The four applications live under KingsChat project "Videofy Live"
# (8cad61f5-7d9a-4c06-a97a-bc0480b27f3c), scope `profile` only; all four were
# APPROVED on 5 Oct 2026 and carry the client ids below. The switch still ships
# `off`, and flips on the day the routes that read these actually exist --
# never before, because a button that cannot work is worse than no button.
# `on` with any value below empty refuses to start.
C7_KINGSCHAT_SIGN_IN=off
# API base. Note this is connect.kingsch.at, NOT the developer portal's host.
C7_KINGSCHAT_BASE_URL=https://connect.kingsch.at
# The PROJECT api key, sent as the `api-key` header when reading a profile.
# One key for all four applications, and the ONLY KingsChat secret there is.
# [founder, from the project page -- never commit a populated copy]
C7_KINGSCHAT_API_KEY=
# Per-application client ids, issued on approval. The web one belongs to the
# application whose redirect url is https://consummate7.com/auth/oauth/kingschat/callback.
C7_KINGSCHAT_WEB_CLIENT_ID=11c1340f-cbfa-4de3-b12d-dbe24f77b0d8
C7_KINGSCHAT_ANDROID_CLIENT_ID=df610edb-80bb-4839-b9ba-09abc908f4a3
C7_KINGSCHAT_IOS_CLIENT_ID=9f37b8a1-2133-427c-887d-132afdb07663
#
# WHY THERE IS NO CLIENT SECRET, and what carries the weight instead.
# KingsChat's token exchange takes grant_type, client_id and code, and NOTHING
# that proves the caller is us -- so a stolen authorization code is redeemable
# by whoever holds it. Three things keep that from being a way in, and all
# three are ours to get right:
#   - delivery is Form POST, so the code arrives in a request body rather than
#     a query string, and never reaches browser history, a Referer header or
#     an access log;
#   - the callback MUST reject any response whose `state` it did not issue and
#     has not already consumed -- there is no PKCE here to fall back on;
#   - the code is single-use and must be exchanged on sight, never stored.

# --- push notifications (Firebase Cloud Messaging) ---
# Firebase project id. [founder]  Absent: push is disabled, ringing falls back to sockets.
FCM_PROJECT_ID=
# Service-account JSON, installed 0640 root:videofy by the founder at this path.
FCM_SERVICE_ACCOUNT_FILE=/etc/videofy-prod/fcm-service-account.json

# --- where this environment writes ---
# Own directories; the unit makes everything else read-only.
MESSAGE_MEDIA_DIR=/var/lib/videofy-prod/message-media
AVATAR_MEDIA_DIR=/var/lib/videofy-prod/avatars
CHANNEL_MEDIA_DIR=/var/lib/videofy-prod/channel-media

# The PRODUCTION media-ingest, for voice-note and message translation.
MEDIA_INGEST_URL=http://127.0.0.1:3102

# --- platform roles ---
# BOTH ship EMPTY and both are fail-closed: empty means nobody carries the
# badge and nobody operates the platform console. These are NOT the programme
# operator allowlist (that is OPERATOR_CONSOLE_ACCOUNT_IDS, in gateway.env AND
# media-ingest.env), and a verified C7 identity is not an entitlement to
# either of them. No staging, QA or test account id belongs in either line.
# Comma-separated account ids that carry the official badge. [founder, after first sign-up]
OFFICIAL_ACCOUNT_IDS=
# Comma-separated account ids allowed to operate the platform console. [founder]
PLATFORM_OPERATOR_ACCOUNT_IDS=
# ISO currency the default tariff is seeded in.
BILLING_CURRENCY=USD

# --- backups (read by backup-database.sh, not by the service) ---
# rclone remote for off-box copies, e.g. b2:c7-backups/production. Unset = local only, with a loud warning.
BACKUP_OFF_BOX_TARGET=
BACKUP_RETAIN_DAYS=14
